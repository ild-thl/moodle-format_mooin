<div class="subpage">
    {{{breadcrumb}}}

    <div class="subpage--certificates d-flex flex-column">
        <h2>{{#str}} certificates, format_mooin4 {{/str}}</h2>

        {{#certificates}}
        <p>{{#str}} certificate_overview_description, format_mooin4 {{/str}}</p>
        <div class="border-card">
            {{{certificates}}}
        </div>
        {{/certificates}}

        {{^certificates}}
        <div class="no-certificates-container">
            <div class="no-certificates-img"></div>
            <span class="blue-info-text">{{#str}} no_certificates_image_text, format_mooin4{{/str}}</span>
        </div>
        {{/certificates}}

        {{#inTop10}}
        <h2>Du bist in den Top 10 %</h2>
        <div class="no-certificates-container">
             <img src="{{badgeimage}}" alt="Top 10% Badge" width="120" height="120">
           <strong>🏅 Du bist in den Top 10 %</strong><br />
        </div>
        {{/inTop10}}

        <div class="topstats mb-4">
            <h4>Deine Statistiken</h4>
            <p>Deine Punktzahl: {{mygrade}}</p>
            <p>Rang: {{myrank}}</p>
            <p>Kursdurchschnitt: {{avggrade}}</p>
        </div>
    </div>
</div>
